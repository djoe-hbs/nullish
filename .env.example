# Copy to .env and fill in. Never commit .env.

# --- Database / queue (docker-compose service names) ---
POSTGRES_USER=nullish
POSTGRES_PASSWORD=nullish
POSTGRES_DB=nullish
DATABASE_URL=postgresql+asyncpg://nullish:nullish@postgres:5432/nullish
REDIS_URL=redis://redis:6379/0

# --- Security ---
# JWT signing (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me
# Fernet key (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=change-me
# First admin account: created on the FIRST start only (when no users exist yet).
# Change the password in the app afterwards (account menu -> Change password).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login
# true in production (HTTPS only cookies); false for local http://localhost
COOKIE_SECURE=false
# Comma-separated list allowed; the browser address of the app
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Crawler ---
CRAWLER_USER_AGENT=SmishBot/1.0 (+https://sols-ai.com)
MAX_LIVE_FETCHES_PER_QUESTION=8
LIVE_FETCH_TIMEOUT_SEC=4

# --- Models: ALL on the rented Vast.ai GPU (3 vLLM servers), via gpu/tunnel.ps1 on this PC ---
# The GPU can be off: crawling/chunking continue, embedding + chat wait until it is back.
# must equal VLLM_API_KEY used in gpu/start_vllm.sh
GPU_API_KEY=change-me
CHAT_BASE_URL=http://host.docker.internal:8001/v1
# Served-model-name aliases from gpu/start_vllm.sh. The real models are picked there by profile
# (test = small chat model, prod = large), so these never change when you scale up.
CHAT_MODEL=nullish-chat
# Router shares the chat model by default (one model in VRAM). Override to split.
ROUTER_BASE_URL=
ROUTER_MODEL=
EMBED_MODEL=nullish-embed
# Real embedding model behind the alias; must stay the same across test/prod (index validity).
EMBED_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
EMBED_URL=http://host.docker.internal:8002
EMBED_DIM=1024
RERANK_MODEL=nullish-rerank
RERANK_URL=http://host.docker.internal:8003
# vllm (/v1/rerank) or tei (/rerank)
RERANK_KIND=vllm
RERANK_MAX_CANDIDATES=30
# Optional CPU fallback reranker (`docker compose --profile cpu-models up`): http://tei-rerank:80
# Slow on this PC's CPU; leave empty unless you have a faster machine.
RERANK_FALLBACK_URL=
