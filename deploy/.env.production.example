# Smish production settings. Copy to the repository root as `.env`, fill every <...>, then
#   chmod 600 .env
# Never commit .env. Generate secrets with the commands shown.

# ---- Site ---------------------------------------------------------------------------------
# Your domain (DNS A record must point at this VPS). Caddy gets the HTTPS certificate itself.
SITE_ADDRESS=<smish.example.com>
# The browser address of the app, exactly (scheme + host, no trailing slash).
FRONTEND_ORIGIN=https://<smish.example.com>
COOKIE_SECURE=true

# ---- First admin account (created on the FIRST start only, when no users exist) -----------
ADMIN_EMAIL=<admin email>
ADMIN_PASSWORD=<initial admin password: change it in the app after the first login>

# ---- Secrets (generate, don't invent) -----------------------------------------------------
# openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48
SECRET_KEY=<generate>
# python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=<generate>
# openssl rand -hex 24
POSTGRES_PASSWORD=<generate>

# ---- Database / queue (containers on the internal Docker network) ---------------------------
POSTGRES_USER=nullish
POSTGRES_DB=nullish
# Must contain the same POSTGRES_PASSWORD as above.
DATABASE_URL=postgresql+asyncpg://nullish:<POSTGRES_PASSWORD>@postgres:5432/nullish
REDIS_URL=redis://redis:6379/0

# ---- GPU server (see deploy/GPU_SERVER.md) --------------------------------------------------
# SSH address of the GPU machine (Vast.ai: Connect -> "direct ssh" IP and port).
GPU_HOST=<gpu ip>
GPU_SSH_PORT=<gpu ssh port>
GPU_SSH_USER=root
# Shared secret: must equal VLLM_API_KEY on the GPU server.  openssl rand -hex 32
GPU_API_KEY=<shared with the GPU server>

# Model servers, reached through the gpu-tunnel container (don't change unless you know why).
CHAT_BASE_URL=http://gpu-tunnel:8001/v1
CHAT_MODEL=nullish-chat
ROUTER_BASE_URL=
ROUTER_MODEL=
EMBED_URL=http://gpu-tunnel:8002
EMBED_MODEL=nullish-embed
EMBED_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
EMBED_DIM=1024
RERANK_URL=http://gpu-tunnel:8003
RERANK_MODEL=nullish-rerank
RERANK_KIND=vllm
RERANK_MAX_CANDIDATES=30
RERANK_FALLBACK_URL=

# ---- Crawler ------------------------------------------------------------------------------
CRAWLER_USER_AGENT=SmishBot/1.0 (+https://<smish.example.com>)
# Never true in production: it disables the protection against crawling internal addresses.
ALLOW_PRIVATE_URLS=false
MAX_LIVE_FETCHES_PER_QUESTION=8
LIVE_FETCH_TIMEOUT_SEC=4
